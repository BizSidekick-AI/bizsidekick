{
  "description": "Capture task-scoped BizSidekick prompt and final-reply evidence for the Public audit ledger.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/public-trace-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\public-trace-hook.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__bizsidekick__bustly_begin_task$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/public-trace-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\public-trace-hook.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__bizsidekick__bustly_begin_task$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/public-trace-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\public-trace-hook.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/public-trace-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\public-trace-hook.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
