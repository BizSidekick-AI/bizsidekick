{
  "schema_version": 1,
  "routes": {
    "shopify-ui": {
      "provider": "shopify",
      "executor": "browser",
      "browser_automation": "allowed",
      "provider_ui_write": "confirmation-gated"
    },
    "meta-marketing-api": {
      "provider": "meta",
      "executor": "bustly-mcp",
      "browser_automation": "forbidden",
      "provider_ui_write": "forbidden",
      "required_tools": [
        "bustly_native_report_export",
        "bustly_native_report_export_status"
      ],
      "template": "meta_campaign_performance"
    },
    "meta-manual-ui": {
      "provider": "meta",
      "executor": "user",
      "browser_automation": "forbidden",
      "provider_ui_write": "user-only"
    }
  },
  "hard_failures": [
    "assistant_browser_action_for_meta",
    "meta_ui_success_claim_without_user_file",
    "browser_fallback_after_meta_api_failure",
    "meta_partial_or_failed_read_reported_as_complete"
  ]
}
